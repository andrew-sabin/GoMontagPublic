@page "/categories/lock/{Slug}"
@using GoMontag.Shared.Enums
@inject ICategoryClientToServerComponentService CategoryService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles ="Admin")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@if (string.IsNullOrWhiteSpace(Slug))
{
	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/">Home</a></li>
			<li class="breadcrumb-item"><a href="/categories">Category</a></li>
			<li class="breadcrumb-item active">Unknown</li>
		</ol>
	</nav>
}
else
{
	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/">Home</a></li>
			<li class="breadcrumb-item"><a href="/categories">Category</a></li>
			<li class="breadcrumb-item active">@category.Name</li>
		</ol>
	</nav>
	<PageTitle>GoMontag Lock Category: @category.Name</PageTitle>
	@if (category.IsLocked)
	{
		<h3>Unlock Category</h3>
	}
	else
	{
		<h3>Lock Category</h3>
	}
	
}

<EditForm Model="@category">
	<div class="form-group">
		<InputCheckbox id="categoryIsLocked" class="form-check-input" @bind-Value="category.IsLocked" />
		<label class="form-check-label" for="categoryIsLocked">Locked</label>
	</div>
	@if (category.IsLocked)
	{
		<div class="form-group">
			<label for="categoryLockedReason">Lock Reason</label>
			<InputTextArea id="categoryLockedReason" class="form-control" @bind-Value="category.lockedReason" />
		</div>
	}
	</EditForm>
<button type="submit" class="btn btn-primary mt-4" @onclick="HandleValidSubmit">Submit</button>
<button type="button" class="btn btn-secondary mt-4 mx-1" @onclick="CancelEdit">Cancel</button>

	@code {
	[Parameter]
	public int? Id { get; set; }
	[Parameter]
	public string? Slug { get; set; }

	CategoryRequest category = new CategoryRequest();

	private IJSObjectReference? module;

	private async Task SetPageTitle(string title)
	{
		if (module != null)
			await module.InvokeVoidAsync("setTitle", title);
	}

	protected override async Task OnInitializedAsync()
	{
		module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/titleHelper.js");
	}

	protected override async Task OnParametersSetAsync()
	{
		if(Slug != null && Slug != "")
		{
			var response = await CategoryService.GetCategoryBySlug(Slug);
			if(response != null)
			{
				category = new CategoryRequest
				{
					Id = response.Id,
					Name = response.Name,
					Description = response.Description,
					Slug = response.Slug,
					IsLocked = response.IsLocked,
					lockedReason = response.lockedReason,
					CreatorsTitle = response.CreatorsTitle,
					FormatsTitle = response.FormatsTitle,
					TypeTitle = response.TypeTitle,
					EditionTitle = response.EditionTitle
				};
				Id = response.Id;
				if (response.IsLocked)
				{
					await SetPageTitle($"GoMontag Unlock Category: {category.Name}");
				}
				else
				{
					await SetPageTitle($"GoMontag Lock Category: {category.Name}");
				}

			}
			else
			{
				Console.WriteLine($"Category '{Slug}' not found.");
				NavigationManager.NavigateTo("not found");
			}
		}
	}

	async Task HandleValidSubmit()
	{
		await CategoryService.LockCategory((int)Id!, category);
		NavigationManager.NavigateTo("/categories");
	}
	async Task CancelEdit()
	{
		NavigationManager.NavigateTo("/categories");
	}
}
