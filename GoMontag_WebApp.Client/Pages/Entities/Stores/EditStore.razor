@page "/stores/edit/{Slug}"
@page "/stores/create"
@inject IStoreClientToServerComponentService StoreService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using System.Text.Json
@attribute [Authorize (Roles ="Admin, Moderator")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@if(Id != null || !String.IsNullOrWhiteSpace(Slug))
{
	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/">Home</a></li>
			<li class="breadcrumb-item"><a href="/stores">Stores</a></li>
			<li class="breadcrumb-item active"><a href="/stores/@store.Slug">@store.Name</a></li>
			<li class="breadcrumb-item active">Editing Store</li>
		</ol>
	</nav>
	<h3>Edit Store Information</h3>
}
else
{
	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/stores">Stores</a></li>
			<li class="breadcrumb-item active">New Store</li>
		</ol>
	</nav>
	<h3>Create New Store</h3>
}
@if (!String.IsNullOrEmpty(store.LogoURL) && String.IsNullOrEmpty(FileUrl))
{
	<div class="mb-3">
		<h3>Current Cover Image</h3>
		<img src="@store.LogoURL" alt="Current Format Cover Image" style="max-width: 200px; max-height: 300px;" />
	</div>
}
else if (!String.IsNullOrEmpty(store.LogoURL) && !String.IsNullOrEmpty(FileUrl))
{
	<div class="mb-3">
		<h3>Current Cover Image</h3>
		<img src="@store.LogoURL" alt="Current Format Cover Image" style="max-width: 200px; max-height: 300px;" />
	</div>
	<div class="mb-3">
		<h3>New Cover Image</h3>
		<img src="@FileUrl" alt="Format Cover Image" style="max-width: 200px; max-height: 300px;" />
	</div>
}
else if (String.IsNullOrEmpty(store.LogoURL) && !String.IsNullOrEmpty(FileUrl))
{
	<div class="mb-3">
		<h3>New Cover Image</h3>
		<img src="@FileUrl" alt="Format Cover Image" style="max-width: 200px; max-height: 300px;" />
	</div>
}


<EditForm Model="store" OnValidSubmit="HandleValidSubmit">
	<DataAnnotationsValidator />
	<div class="mb-3">
		<label for="storeName">Store Name</label>
		<InputText id="storeName" class="form-control" @bind-Value="store.Name" />
		<ValidationMessage For="@(() => store.Name)" />
	</div>
	@if (Id != null || !String.IsNullOrWhiteSpace(Slug))
	{
		<div class="mb-3">
			<label for="storeSlug">Slug</label>
		<InputText id="storeSlug" class="form-control" @bind-Value="store.Slug" />
			<ValidationMessage For="@(() => store.Slug)" />
		</div>
	}
	<div class="mb-3">
		<label for="storeLogo">Store Logo URL</label>
		<SfUploader ID="UploadFiles" AutoUpload="true" AllowedExtensions=".jpg,.jpeg,.png,.svg, .webp" EnableHtmlSanitizer="true">
				<UploaderAsyncSettings SaveUrl="/api/Image/Save" RemoveUrl="/api/Image/DeleteFile" />
				<UploaderEvents FileSelected="@OnFileSelected" BeforeRemove="@OnBeforeFileRemoved" ValueChange="@OnChange" Success="@OnSuccess" />
			</SfUploader>
		<ValidationMessage For="@(() => store.LogoURL)" />
	</div>
	<div class="mb-3">
		<label for="storeOnline">Online Orders Available</label>
		<InputCheckbox id="storeOnline" class="form-check-input" @bind-Value="store.Online" />
		<ValidationMessage For="@(() => store.Online)" />
	</div>
	<div class="mb-3">
		<label for="storeIndustry">Store Industry</label>
		<InputText id="storeIndustry" class="form-control" @bind-Value="store.Industry" />
		<ValidationMessage For="@(() => store.Industry)" />
	</div>
	<div class="mb-3">
		<label for="storeStreet">Street Address</label>
		<InputText id="storeStreet" class="form-control" @bind-Value="store.Street" />
		<ValidationMessage For="@(() => store.Street)" />
	</div>
	<div class="mb-3">
		<label for="storeCity">City</label>
		<InputText id="storeCity" class="form-control" @bind-Value="store.City" />
		<ValidationMessage For="@(() => store.City)" />
	</div>
	<div class="mb-3">
		<label for="storeState">State</label>
		<InputText id="storeState" class="form-control" @bind-Value="store.State" />
		<ValidationMessage For="@(() => store.State)" />
	</div>
	<div class="mb-3">
		<label for="storePostalCode">Postal Code</label>
		<InputText id="storePostalCode" class="form-control" @bind-Value="store.PostalCode" />
		<ValidationMessage For="@(() => store.PostalCode)" />
	</div>
	<div class="mb-3">
		<label for="storeCountry">Country</label>
		<InputText id="storeCountry" class="form-control" @bind-Value="store.Country" />
		<ValidationMessage For="@(() => store.Country)" />
	</div>
	<div class="mb-3">
		<label for="storePhone">Phone Number</label>
		<InputText id="storePhone" class="form-control" @bind-Value="store.Phone" />
		<ValidationMessage For="@(() => store.Phone)" />
	</div>
	<div class="mb-3">
		<label for="storeEmail">Email Address</label>
		<InputText id="storeEmail" class="form-control" @bind-Value="store.Email" />
		<ValidationMessage For="@(() => store.Email)" />
	</div>
	<div class="mb-3">
		<label for="storeWebsite">Website URL</label>
		<InputText id="storeWebsite" class="form-control" @bind-Value="store.WebsiteURL" />
		<ValidationMessage For="@(() => store.WebsiteURL)" />
	</div>
	<button type="submit" class="btn btn-primary mt-4">Submit</button>
	<button type="button" class="btn btn-secondary mt-4 mx-2" @onclick="CancelEdit">Cancel</button>
</EditForm>

@code {
	[Parameter]
	public int? Id { get; set; }
	[Parameter]
	public string? Slug { get; set; }

	StoreRequest store = new StoreRequest();

	private List<string> savedFiles = new();
	private List<string> fileLocations = new();
	private List<Syncfusion.Blazor.Inputs.FileInfo> uploadedFiles = new();

	public string? FileUrl { get; set; }

	private IJSObjectReference? module;

	private async Task SetPageTitle(string title)
	{
		if (module != null)
			await module.InvokeVoidAsync("setTitle", title);
	}

	protected override async Task OnInitializedAsync()
	{
		module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/titleHelper.js");
	}

	protected override async Task OnParametersSetAsync()
	{
		if (!string.IsNullOrWhiteSpace(Slug))
		{
			var response = await StoreService.GetStoreBySlugAsync(Slug);
			if (response != null)
			{
				store = new StoreRequest
				{
					Id = response.Id,
					Name = response.Name,
					Slug = response.Slug,
					LogoURL = response.LogoURL,
					Industry = response.Industry,
					Online = response.Online,
					Street = response.Street,
					City = response.City,
					State = response.State,
					PostalCode = response.PostalCode,
					Country = response.Country,
					Phone = response.Phone,
					WebsiteURL = response.WebsiteURL
				};
			}
			await SetPageTitle($"Editing Store {store.Name} - GoMontag");
		}
		else
		{
			await SetPageTitle($"Creating a New Store - GoMontag");
		}
	}

    private async Task OnFileSelected(SelectedEventArgs args)
    {
        if (string.IsNullOrEmpty(Slug))
        {
            args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = "stores" },
			new { blobDirectory = "newly-created" + "/cover-image"} };
        }
        else
        {
            args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = "stores" },
			new { blobDirectory = Slug + "/cover-image"} };
        }

    }

    private async Task OnBeforeFileRemoved(BeforeRemoveEventArgs args)
    {
        if (string.IsNullOrEmpty(Slug))
        {
            args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = "stores" },
			new { blobDirectory = "newly-created" + "/cover-image"} };
        }
        else
        {
            args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = "stores" },
			new { blobDirectory = Slug + "/cover-image"} };
        }
    }

    private async Task OnChange(Syncfusion.Blazor.Inputs.UploadChangeEventArgs args)
    {
		uploadedFiles.Clear();
		if (args?.Files != null)
		{
			foreach (var f in args.Files)
			{
				uploadedFiles.Add(f.FileInfo);
			}
		}
	}

	private void OnFailure(FailureEventArgs args)
	{
		Console.WriteLine($"Upload failed: {args?.Response.ResponseText}");
	}

	private void OnSuccess(SuccessEventArgs args)
	{
		try
		{
			if (args == null) return;

			var response = args.Response.ResponseText;
			if (response == null)
				return;
			ParseResponseString(response);

			FileUrl = fileLocations[0];
		}
		catch (Exception ex)
		{
			Console.WriteLine($"OnSuccess parse error: {ex.Message}");
			FileUrl = null;
		}
	}

	private void ParseResponseString(string json)
	{
		using var doc = System.Text.Json.JsonDocument.Parse(json);
		ParseResponseJsonElement(doc.RootElement);
	}

	private void ParseResponseJsonElement(JsonElement root)
	{
		if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
		{
			if (root.TryGetProperty("files", out var files) && files.ValueKind == JsonValueKind.Array)
			{
				foreach (var f in files.EnumerateArray())
				{
					var name = f.GetString();
					if (!string.IsNullOrEmpty(name) && !savedFiles.Contains(name))
						savedFiles.Add(name);
				}
			}

			if (root.TryGetProperty("fileLocations", out var locs) && locs.ValueKind == JsonValueKind.Array)
			{
				foreach (var l in locs.EnumerateArray())
				{
					var loc = l.GetString();
					if (!string.IsNullOrEmpty(loc) && !fileLocations.Contains(loc))
						fileLocations.Add(loc);
				}
			}
		}
	}


	private async Task HandleValidSubmit()
	{
		if (!string.IsNullOrEmpty(FileUrl))
			store.LogoURL = FileUrl;
		if (Id != null || !string.IsNullOrWhiteSpace(Slug))
		{
			await StoreService.UpdateStoreAsync((int) store.Id, store);
			NavigationManager.NavigateTo($"/stores/{store.Slug}");
		}
		else
		{
			await StoreService.CreateStoreAsync(store);
			NavigationManager.NavigateTo($"/stores/{store.Slug}");
		}
	}

	async Task CancelEdit()
	{
		if(Id != null || !string.IsNullOrWhiteSpace(Slug))
		{
			NavigationManager.NavigateTo($"/stores/{store.Slug}");
		}
		else
		{
			NavigationManager.NavigateTo($"/stores");
		}
	}
}
