@page "/forgot-password"
@using GoMontag_Shared.Models.Emails
@inject NavigationManager navigationManager
@inject IAuthClientToServerComponentService authService
@rendermode InteractiveWebAssembly

<div class="site-grid">
    <div class="left-column"></div>
    <div class="main-content-column">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Forgot Password</li>
            </ol>
        </nav>

        <PageTitle>Forgot Password - GoMontag</PageTitle>
        <h3>Forgot Password</h3>
        <div class="input-form">
            <EditForm Model="PasswordRequest" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div>
                    <label for="username">Username:</label>
                    <InputText id="username" @bind-Value="PasswordRequest.Username" class="form-control" />
                    <ValidationMessage For="() => PasswordRequest.Username" />
                </div>
                <div>
                    <label for="email">Email:</label>
                    <InputText id="email" @bind-Value="PasswordRequest.Email" class="form-control" />
                    <ValidationMessage For="() => PasswordRequest.Email" />
                </div>
                <button class="btn btn-primary mt-2" type="submit">Submit Request</button>
            </EditForm>
        </div>
        

        @if (success == false && passwordRequestFailed == true &&
        (!string.IsNullOrWhiteSpace(PasswordRequest.Username) || !string.IsNullOrWhiteSpace(PasswordRequest.Email)))
        {
            <div class="alert alert-danger mt-2">No Account with Username or Email found.</div>
        }
        else if (success == false && passwordRequestFailed == true &&
            (string.IsNullOrWhiteSpace(PasswordRequest.Username) && string.IsNullOrWhiteSpace(PasswordRequest.Email)))
        {
            <div class="alert alert-danger mt-2">Please enter in the Username or Email related to your account.</div>
        }
        else if (success == true && passwordRequestFailed == false)
        {
            <div class="alert alert-success mt-2">Password Request has been sent! Please check your email for a link to reset your password.</div>
        }
    </div>
    <div class="right-column"></div>
</div>






@code {
    ForgotPasswordRequest PasswordRequest = new ForgotPasswordRequest();
    private bool success = false;
    private bool passwordRequestFailed = false;
    private string? message = "";

    async Task HandleSubmit()
    {
        success = false;
        passwordRequestFailed = false;
        message = string.Empty;

        var passwordEmailRequest = await authService.RequestPasswordReset(PasswordRequest);
        var psswrdRequestSuccess = passwordEmailRequest.Success;

        if (!psswrdRequestSuccess)
        {
            success = false;
            message = "No Account with Username or Email found.";
            passwordRequestFailed = true;
        }
        else
        {
            success = true;
            message = "Password Request has been sent! Please check your email for a link to reset your password.";
            passwordRequestFailed = false;
        }
    }

}
