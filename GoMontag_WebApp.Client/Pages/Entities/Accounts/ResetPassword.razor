@page "/reset-email"
@using GoMontag_Shared.Models.Emails
@inject HttpClient httpClient
@inject NavigationManager navigationManager
@rendermode InteractiveWebAssembly

<PageTitle>Reset Password For GoMontag Account</PageTitle>
<div class="site-grid">
    <div class="left-column"></div>
    <div class="main-content-column">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Reset Password</li>
            </ol>
        </nav>
        <h3>Reset Password</h3>
        <div class="input-form">
            @if (!string.IsNullOrWhiteSpace(Username) && !string.IsNullOrWhiteSpace(Code))
            {
                <EditForm Model="request" OnValidSubmit="HandleResetPassword">
                    <DataAnnotationsValidator />

                    <input type="hidden" @bind="request.Username" />
                    <input type="hidden" @bind="request.Code" />

                    <div class="mb-3">
                        <label for="password" class="form-label">New Password</label>
                        <InputText type="password" id="password" class="form-control" @bind-Value="request.Password" />
                        <ValidationMessage For="@(() => request.Password)" />
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Confirm Password</label>
                        <InputText type="password" id="confirmPassword" class="form-control" @bind-Value="request.ConfirmPassword" />
                        <ValidationMessage For="@(() => request.ConfirmPassword)" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @(isSubmitting ? "Resetting..." : "Reset Password")
                    </button>
                </EditForm>
            }
            else
            {
                <div class="alert alert-danger">
                    Invalid password reset link.
                </div>
            }

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-@(isSuccessful ? "success" : "danger") mt-3">
                    @message
                </div>

                @if (isSuccessful)
                {
                    <a href="/login" class="btn btn-primary">Go Login</a>
                }
            }
        </div>
        
    </div>
    <div class="right-column"></div>
</div>




@code {
    [Parameter]
    [SupplyParameterFromQuery (Name = "user")]
    public string? Username { get; set; }

    [Parameter]
    [SupplyParameterFromQuery (Name = "c")]
    public string? Code { get; set; }

    private ResetPasswordRequest request = new();
    private bool isSubmitting = false;
    private string message = string.Empty;
    private bool isSuccessful = false;

    protected override void OnInitialized()
    {
        request.Username = Username ?? string.Empty;
        request.Code = Code ?? string.Empty;
    }

    private async Task HandleResetPassword()
    {
        isSubmitting = true;
        message = string.Empty;

        try
        {
            var response = await httpClient.PostAsJsonAsync("api/Account/reset-password", request);

            if (response.IsSuccessStatusCode)
            {
                isSuccessful = true;
                message = "Password reset successful! Please login with your new password.";
            }
            else
            {
                isSuccessful = false;
                message = "Error reseting password.";
            }
        }
        catch
        {
            isSuccessful = false;
            message = "Network error. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

}
