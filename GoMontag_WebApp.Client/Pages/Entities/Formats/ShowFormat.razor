@code {
	[Parameter]
	public int formatId { get; set; }
	[Parameter]
	public int productId { get; set; }
	[Parameter]
	public string? ProductSlug { get; set; }
	[Parameter]
	public string? HashedId { get; set; }
	[Parameter]
	public string? formatSlug { get; set; }

	private bool isLoading = true;

	private DateTimeOffset userModifiedDate;

	private FormatResponse? format = new FormatResponse();
	private FormatRevisionResponse? formatRevision = new FormatRevisionResponse();
	private ProductResponse? product = new();
	private FormatTypeResponse? formatType = new FormatTypeResponse();

	private string? formatDescription { get; set; } = string.Empty;

	// private string? 

	private string? ownershipInformation { get; set; }

	private Lightbox lightbox = new Lightbox();
	private List<string> imageUrls = new();
	private List<string> imageAlts = new();

	protected override async Task OnInitializedAsync()
	{
		if (HashedId != null)
		{
			var result = await FormatService.GetFormatByID(HashedId);
			if (result == null)
			{
				format = null;
				if (ProductSlug != null)
					product = await productService.GetProductBySlug(ProductSlug);
			}
			else
			{
				format = result;
				if (ProductSlug != null)
					product = product = await productService.GetProductBySlug(ProductSlug);
				else
				{
					product = await productService.GetProductBySlug(format.Value.Product!.Slug!);
				}
				formatType = await FormatTypeService.GetFormatTypeByID(result.Value.FormatTypeId);

				// if (format.Value.formatrevisionid <= 0)
				// {
				// 	throw new Exception("Format page could not load most recent revision. Invalid revision id.");
				// }
				formatRevision = await FormatRevisionService.GetRevisionById(format.Value.formatrevisionid);
				if (formatType != null && formatRevision != null)
				{
					ownershipInformation = GetEnumDisplayDescription(formatRevision.Value.OwnershipLevel);
					userModifiedDate = TimeZoneService.ConvertToUserTime(formatRevision.Value.ModifiedDate);
					ExtractImages((FormatRevisionResponse)formatRevision);
					formatDescription = await SanitizeHTML(formatRevision.Value.Description);
				}
				else
				{
					format = null;
					product = product = await productService.GetProductBySlug(ProductSlug!);
				}

			}
		}
		else
		{
			format = null;
		}

		isLoading = false;
	}

	private string GetEnumDisplayName(Enum value)
	{
		var field = value.GetType().GetField(value.ToString());
		var attr = field?.GetCustomAttributes(typeof(DisplayAttribute), false)
						.Cast<DisplayAttribute>()
						.FirstOrDefault();
		return attr?.Name ?? value.ToString();
	}

	private string GetEnumDisplayDescription(Enum value)
	{
		var field = value.GetType().GetField(value.ToString());
		var attr = field?.GetCustomAttributes(typeof(DisplayAttribute), false)
						.Cast<DisplayAttribute>()
						.FirstOrDefault();
		return attr?.Description ?? value.ToString();
	}

	private string GetEnumDisplayGroup(Enum value)
	{
		var field = value.GetType().GetField(value.ToString());
		var attr = field?.GetCustomAttributes(typeof(DisplayAttribute), false)
						.Cast<DisplayAttribute>()
						.FirstOrDefault();
		return attr?.GroupName ?? value.ToString();
	}

	/* Getting Images From Description */
	private void ExtractImages(FormatRevisionResponse formatRevision)
	{
		imageUrls = HTMLImageExtractor.ExtractImageUrls(formatRevision.Description);
		imageAlts = HTMLImageExtractor.ExtractImageAlts(formatRevision.Description);
	}

	private string CreateIDHash(int Id)
	{
		var sqids = new SqidsEncoder<int>(new()
		{
			MinLength = 0,
			Alphabet = "",
		});
		var hash = sqids.Encode(Id);
		return hash;
	}

	private int DecodeHash(string hash)
	{
		var sqids = new SqidsEncoder<int>(new()
		{
			MinLength = 0,
			Alphabet = "",
		});
		var realId = sqids.Decode(hash).Single();
		return realId;
	}

	private async void HandleImageClick(string imageUrl)
	{
		var index = imageUrls.FindIndex(url => url == imageUrl);
		if (index >= 0 && lightbox != null)
		{
			lightbox.ShowImage(index);
		}
	}

	private async Task<string> SanitizeHTML(string html)
	{
		if (string.IsNullOrWhiteSpace(html)) return html;

		html = SanitizeImageMarkup(html);
		html = SanitizeIframe(html);

		return html;
	}

	private string SanitizeImageMarkup(string html)
	{
		if (string.IsNullOrWhiteSpace(html)) return html;
		// Remove width and height attributes
		html = Regex.Replace(
			html,
			@"\s*(height)\s*=\s*[""'][^""']*[""']",
			"",
			RegexOptions.IgnoreCase);
		// Strip width/height (and min/max variants) from the style attribute
		html = Regex.Replace(
			html,
			@"(style\s*=\s*[""'])([^""']*)([""'])",
			m =>
			{
				var cleaned = Regex.Replace(
					m.Groups[2].Value,
					@"(^|;)\s*(width|height|min-width|max-width|min-height|max-height)\s*:[^;]*",
					"",
					RegexOptions.IgnoreCase);
				return m.Groups[1].Value + cleaned.Trim(';', ' ') + m.Groups[3].Value;
			},
			RegexOptions.IgnoreCase);
		return html;
	}

	private string SanitizeIframe(string html)
	{
		if (string.IsNullOrWhiteSpace(html)) return html;
		var iframePattern = @"<iframe\s([^>]*)>";
		var replacement = @"<div class=""iframe-container"" style=""position: relative; width: 100%; max-width: 560px; max-height: 315px;
		padding-bottom: 265px; padding-top:50px;"";><iframe $1>";

		html = Regex.Replace(html, iframePattern, replacement, RegexOptions.IgnoreCase);

		html = Regex.Replace(html, @"</iframe>", @"</iframe></div>", RegexOptions.IgnoreCase);

		html = NormalizeIframeAttributes(html);

		return html;
	}


	private string NormalizeIframeAttributes(string htmlContent)
	{
		// Any space between <iframe where there is 0 or more > whether that would be in the beginning of a paragraph or otherwise
		string pattern = @"<iframe\s+([^>]*)>";
		return Regex.Replace(htmlContent, pattern, match =>
		{
			string tagContent = match.Groups[1].Value;
			//Any space betwen style= and anygroup or range between "" and replace it with an empty string
			tagContent = Regex.Replace(tagContent, @"\s*style=""[^""]*""", "", RegexOptions.IgnoreCase);
			//Any space betwen width= and anygroup or range between "" and replace it with an empty string
			tagContent = Regex.Replace(tagContent, @"\s*width=""[^""]*""", "", RegexOptions.IgnoreCase);
			//Any space betwen height= and anygroup or range between "" and replace it with an empty string
			tagContent = Regex.Replace(tagContent, @"\s*height=""[^""]*""", "", RegexOptions.IgnoreCase);

			return $@"<iframe width=""100%"" height=""315px"" style=""position: absolute; top: 0; left: 0; width: 100%; height: 315px;""{tagContent}>";
		}, RegexOptions.IgnoreCase);
	}

	private void EditHashedFormat(string hashedId)
	{
		NavigationManager.NavigateTo($"/products/view/{ProductSlug}/formats/{hashedId}/edit");
	}
	private void LockHashedFormat(string hashedId)
	{
		NavigationManager.NavigateTo($"/products/view/{ProductSlug}/formats/{hashedId}/lock");
	}
	private void ViewRevisions(string hashedId)
	{
		NavigationManager.NavigateTo($"/products/view/{ProductSlug}/formats/{hashedId}/revisions");
	}

}
