@page "/formats/{FormatHash}/allimages"
@inject IFormatImageClientToServerComponentService FormatImageService
@inject IFormatClientToServerComponentService FormatService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject HttpClient Http
@attribute [AllowAnonymous]
@rendermode InteractiveServer


<h3>Images used in Format Article</h3>
@if (isLoading)
{
    <p><strong>Loading In Format Images Please Wait...</strong></p>
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (!isLoading && totalImages > 0)
{
    <QuickGrid Items="queryableFormatImages">
        <TemplateColumn Title="">
            <ChildContent Context="i">
                <a href="@($"formats/{FormatHash}/images/{CreateImageIDHash(i.Id)}")">
                    <img src="@i.ImageUrl" class="img-thumbnail"
                         style="max-width: 40px; max-height: 30px; min-width: 30px; min-height: auto;" />
                </a>
            </ChildContent>
        </TemplateColumn>
        <PropertyColumn Property="i => i.ImageName" Sortable="true" />
        <PropertyColumn Property="i => i.CreatedDate" Sortable="true" Title="Added" />
    </QuickGrid>
}
else
{
    <p><strong>No images found.</strong></p>
}


@code {
    [Parameter]
    public string? FormatHash { get; set; }

    private bool isLoading = true;
    private bool hasImages = true;
    private List<FormatImageResponse> formatImages = new List<FormatImageResponse>();
    private IQueryable<FormatImageResponse>? queryableFormatImages;
    private int totalImages { get; set; }

    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(FormatHash))
        {
            await LoadFormatImages();
            isLoading = false;
        }
        else
        {
            hasImages = false;
        }
    }

    private async Task LoadFormatImages()
    {
        try
        {
            var formatImagesResponse = await FormatImageService.GetAllFormatImagesByFormatId(FormatHash);
            if (formatImagesResponse.Count > 0)
            {
                queryableFormatImages = formatImagesResponse.AsQueryable();
                totalImages = queryableFormatImages.Count();
            }
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error loading images from format: {ex.Message}");
        }
    }

    private string CreateImageIDHash(int Id)
        {
            var sqids = new SqidsEncoder<int>(new()
            {
                MinLength = 0,
                Alphabet = "",
            });
            var hash = sqids.Encode(Id);
            return hash;
        }
}
