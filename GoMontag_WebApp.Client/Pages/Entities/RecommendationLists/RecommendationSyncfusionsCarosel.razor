@page "/carousel-test/{listId:int}"
@inject IRecommendationListClientToServerComponentService recommendationListService
@inject IRecommendationItemClientToServerComponentService recommendationItemService
@inject IJSRuntime JS
@inject NavigationManager navigationManager
@implements IAsyncDisposable
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons
@rendermode InteractiveServer


<div @ref="myComponent">
@if(isLoading == false && listExists == true && isEmpty == false)
{
    <div class="recommendation-block">
        <div class="recommendation-details">
                <div class="recommendation-title">
                    <h3>@recommendationList.Value.Name</h3>
                </div>
                <div class="recommendation-description">
                    <p>@recommendationList.Value.Description</p>
                    <a href="/recommend/@GenerateListHash(recommendationList!.Value.Id)">View Full List Here</a>
                </div>
        </div>
            <div class="control-section recommendation-carosel">
                <div class="carousel-samplecol-lg-12 content-wrapper">
                    <div class="carousel-container">
                        <SfCarousel Interval="10000" AutoPlay="true"
                                    ButtonsVisibility="CarouselButtonVisibility.Visible" ShowPlayButton="false" 
                                    PartialVisible="false" IndicatorsType="CarouselIndicatorsType.Progress">
                            <PreviousButtonTemplate>
                                <SfButton CssClass="e-outline">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40">
                                        <path d="m13.5 7.01 13 13m-13 13 13-13"></path>
                                    </svg>
                                </SfButton>
                            </PreviousButtonTemplate>
                            <NextButtonTemplate>
                                <SfButton CssClass="e-outline">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40">
                                        <path d="m13.5 7.01 13 13m-13 13 13-13"></path>
                                    </svg>
                                </SfButton>
                            </NextButtonTemplate>
                            <ChildContent>
                                @foreach (var item in caroselItems)
                                {
                                    <CarouselItem>
                                        <RecommendationSyncfusionCard recommendedItemId="@item.Id" />
                                    </CarouselItem>
                                }
                            </ChildContent>

                        </SfCarousel>
                    </div>

            
                </div>
            </div>
    </div>
    
}
else if(!isLoading && listExists && isEmpty)
{
    <div class="empty-list">
            <h3>@recommendationList.Value.Name is Empty</h3>
            <p><strong>Please add recommendations to it.</strong></p>
            <a href="/recommend/@GenerateListHash(recommendationList!.Value.Id)">View Full List Here</a>
    </div>    
}
    else if (isLoading == true)
{
    <p><strong>Loading In Product Information Please Wait...</strong></p>
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
</div>

<style>
    .recommendation-block{
        height: 525px;
        max-width: 540px;
    }
    .recommendation-details{
        padding: 5px;
        border: solid;
        border-width: 2px;
        border-color: lightgrey;
        border-radius: 5px;
    }

    .control-container {
        border: 1px solid #e5e5e5;
        border-radius: 0.5em;
        margin: 0 auto 2em;
        max-width: 420px;
        height: 420px;
    }

    .e-carousel .slide-content {
        align-items: center;
        display: flex;
        font-size: 1.25rem;
        height: 100%;
        justify-content: center;
    }

    .e-carousel .e-carousel-navigators .e-previous,
    .e-carousel .e-carousel-navigators .e-next {
        margin: -60px;
        background: rgba(97, 97, 97, 0.49);
    }

    .e-carousel .e-carousel-navigators .e-btn:active,
    .e-carousel .e-carousel-navigators .e-btn:hover {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }

    .e-carousel .e-carousel-navigators .e-btn svg {
        fill: none;
        stroke: currentColor;
        stroke-linecap: square;
        stroke-width: 8px;
        height: 2rem;
        vertical-align: middle;
        width: 2rem;
    }

    .e-carousel .e-carousel-navigators .e-previous .e-btn svg {
        transform: rotate(180deg);
    }

    .e-carousel .e-carousel-indicators {
        bottom: auto;
    }
</style>

@code {
    [Parameter]
    public int listId { get; set; }
    [Parameter]
    public bool isFrontPage { get; set; } = false;

    private int itemsPerPage { get; set; } = 3;
    private int selectedIndex { get; set; }

    private ListResponse? recommendationList { get; set; }
    private List<RecommendedItemResponse> recommendedItems { get; set; } = new();
    private IQueryable<RecommendedItemResponse>? caroselItems { get; set; }



    private bool auto { get; set; } = false;

    private bool isLoading { get; set; } = true;
    private bool listExists { get; set; } = true;
    private bool isEmpty { get; set; } = false;



    // Resize Component Variables
    private ElementReference myComponent;
    private int width;
    private int height;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<ComponentSizeHelper>? dotNetRef;



    protected override async Task OnParametersSetAsync()
    {
        if(listId <= 0)
        {
            listExists = false;
        }
        else
        {
            var listHash = GenerateListHash(listId);
            var recList = await recommendationListService.GetRecommendListById(listHash);
            if (recList == null)
            {
                listExists = false;
            }
            else
            {
                recommendationList = recList;
                var recItems = await recommendationItemService.GetItemsByRecommendationList(listHash);
                recommendedItems = recItems;
                caroselItems = recItems.AsQueryable().Take(12);
            }
        }
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/componentHelper.js");

            dotNetRef = DotNetObjectReference.Create(new ComponentSizeHelper(this));
            await _jsModule.InvokeVoidAsync("observeComponentSize", myComponent, dotNetRef);
            itemsPerPage = CalculateItemsPerPage(width, height);
        }
    }

    [JSInvokable]
    public void OnComponentResized(float newWidth, float newHeight)
    {
        width = (int)newWidth;
        height = (int)newHeight;
        itemsPerPage = CalculateItemsPerPage(width, height);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetRef != null)
        {
            dotNetRef.Dispose();
        }
    }

    // Helper class for the JS callback
    public class ComponentSizeHelper
    {
        private readonly ComponentBase component;

        public ComponentSizeHelper(ComponentBase component)
        {
            this.component = component;
        }

        [JSInvokable]
        public void OnComponentResized(float newWidth, float newHeight)
        {
            ((dynamic)component).OnComponentResized(newWidth, newHeight);
        }
    }

    public class Dimensions { public int Width { get; set; } public int Height { get; set; } }

    private int CalculateItemsPerPage(int width, int height)
    {
        var aspectRatio = (double)width / height;

        if (width < 576)
            return 1;
        else if (width < 826)
            return 2;
        else if (aspectRatio > 2.0) // very wide
            return 3;
        else
            return 3;
    }

    public static string GenerateListHash(int id)
    {
        var sqids = new SqidsEncoder<int>(new()
        {
            MinLength = 0,
            Alphabet = "",
        });
        var hash = sqids.Encode(id);
        return hash;
    }

}
