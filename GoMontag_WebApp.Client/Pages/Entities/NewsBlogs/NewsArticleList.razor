@page "/site-news"

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject INewsBlogClientToServerComponentService NewsBlogService
@inject IAuthClientToServerComponentService AuthService
@inject IJSRuntime JSRuntime
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Blog Articles - GoMontag</PageTitle>

<div class="article-grid">
    <div class="left-column"></div>
    <div class="main-content-column">
        <div class="article-breadcrumbs-col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active">Blog</li>
                </ol>
            </nav>
        </div>
        <h3>Past Site News</h3>
        <div class="news-blog-search-results">
                <div class="category-select">
                    <div class="search-categories">
                        <AuthorizeView Roles="Admin" Context="authState">
                            <Authorized>
                                <select class="form-select" @bind="SelectedType">
                                    <option value="">All</option>
                                    <option value="Update">Updates </option>
                                    <option value="Personal">Personal</option>
                                    <option value="Informational">Informational</option>
                                </select>
                            </Authorized>
                            <NotAuthorized>
                                <select class="form-select" @bind="SelectedType">
                                    <option value="Update">Updates </option>
                                    <option value="Personal">Personal </option>
                                    <option value="Informational">Informational</option>
                                </select>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
                <div class="news-blog-create-new">
                    <button class="btn btn-primary" onclick="@(() => CreateArticle())">
                    <i class="bi bi-plus-square"></i> Create New Article
                    </button>
                </div>
                <div class="news-blog-quickgrid">
                    <QuickGrid Items="filteredNewsBlogs" Pagination="pagination">
                        <TemplateColumn Context="n" Title="Title">
                            <a href="@($"site-news/article/{n.slug}")">@n.Title</a>
                        </TemplateColumn>
                        <PropertyColumn title="Date Published" Property=" n => n.CreatedDate" Format="MM-dd-yyyy" Sortable="true" />
                    </QuickGrid>

                </div>
                <div class="page-buttons">
                    Page(s):
                    @if (pagination.TotalItemCount.HasValue)
                    {
                        for (var pageIndex = 0; pageIndex <= pagination.LastPageIndex; pageIndex++)
                        {
                            var capturedIndex = pageIndex; // Capture the current page index
                            <button @onclick="@(() => GoToPageAsync(capturedIndex))"
                                    class="btn btn-primary @PageButtonClass(capturedIndex)"
                                    aria-current="@AriaCurrentValue(capturedIndex)"
                                    aria-label="Go to page @(pageIndex + 1)">
                                @(pageIndex + 1)
                            </button>
                        }
                    }
                </div>
            </div>
        
    </div>
    <div class="right-column"></div>
</div>

<style>>
    .rowbackground{
        background: rgba(255,255,255,0.4);
    }
</style>


@code {
    private string? SelectedType = "";

    private List<NewsBlogResponse>? NewsBlogs = new List<NewsBlogResponse>();

    private IQueryable<NewsBlogResponse>? queryableNewsBlogs;
    private IQueryable<NewsBlogResponse>? filteredNewsBlogs =>
        string.IsNullOrWhiteSpace(SelectedType)
            ? queryableNewsBlogs
            : queryableNewsBlogs?.Where(n => n.ArticleType == SelectedType);

    PaginationState pagination = new PaginationState { ItemsPerPage = 20 };

    private bool isAuthorized = false;

    private bool isLoading = true;

    private IJSObjectReference? module;

    private async Task SetPageTitle(string title)
    {
        if (module != null)
            await module.InvokeVoidAsync("setTitle", title);
    }

    protected override async Task OnInitializedAsync()
    {
        module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/titleHelper.js");
        await SetPageTitle($"Blog Articles - GoMontag");
        await LoadNewsBlogs();
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                SelectedType = "Update";
                isLoading = false;
                return;
            }
            var currentUserRole = user.IsInRole("Admin");
            isAuthorized = currentUserRole;
            if (!isAuthorized)
            {
                SelectedType = "Update";
            }
            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading blog entries: {ex}", ex);
            NavigationManager.NavigateTo("error");
        }

    }

    private async Task LoadNewsBlogs()
    {
        try
        {
            var response = await NewsBlogService.GetNewsBlogs();
            NewsBlogs = response;
            queryableNewsBlogs = response.AsQueryable();
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error loading articles: {ex.Message}");
        }
    }

    private void CreateArticle()
    {
        NavigationManager.NavigateTo($"/site-news/createArticle");
    }
    private void EditArticle(string slug)
    {
        NavigationManager.NavigateTo($"/news/article/{slug}/edit");
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        await pagination.SetCurrentPageIndexAsync(pageIndex);
    }

    private string? PageButtonClass(int pageIndex) => pagination.CurrentPageIndex == pageIndex ? "current" : null;

    private string? AriaCurrentValue(int pageIndex) => pagination.CurrentPageIndex == pageIndex ? "page" : null;

}
