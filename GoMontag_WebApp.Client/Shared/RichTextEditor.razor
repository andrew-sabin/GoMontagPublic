<SfRichTextEditor @ref="rteObj" Placeholder="@Placeholder" @bind-Value="@Content" MaxLength="@MaxLength" ShowCharCount="true" EnableXhtml="true">
    <RichTextEditorPasteCleanupSettings KeepFormat="false" PlainText="false" Prompt="false" />
    <RichTextEditorQuickToolbarSettings Image="@Image" />
    <RichTextEditorEvents BeforeUploadImage="@OnBeforeUploadImage" FileUploading="@OnMediaUploading" OnActionBegin="@actionBegin"
                          FileRemoving="@FileRemoveHandler" OnImageRemoving="@OnImageRemovingHandler" />
    <RichTextEditorImageSettings MaxFileSize="2500000" SaveUrl="api/Image/Save" Path="@uploadPath" MaxWidth="900" />
    <RichTextEditorMediaSettings SaveFormat="SaveFormat.Base64" SaveUrl="api/Video/Save"></RichTextEditorMediaSettings>
    <RichTextEditorAudioSettings SaveURL="api/Video/Save" Path="@uploadPath" MaxFileSize="2500000"></RichTextEditorAudioSettings>
    <RichTextEditorVideoSettings SaveURL="api/Video/Save" Path="@uploadPath" MaxFileSize="0" MaxWidth="560" MinWidth="560" MaxHeight="315" MinHeight="315"></RichTextEditorVideoSettings>
    <RichTextEditorToolbarSettings Items="@Tools" Type="ToolbarType.MultiRow">
        <RichTextEditorCustomToolbarItems>
            <RichTextEditorCustomToolbarItem Name="ImportHTML">
                <Template>
                    <SfUploader ID="UploadFiles" ShowFileList="false" CssClass="e-import">
                        <UploaderAsyncSettings SaveUrl="api/RTFEditor/Import"></UploaderAsyncSettings>
                        <UploaderEvents Success="OnSuccess"></UploaderEvents>
                        <UploaderButtons Browse=""></UploaderButtons>
                    </SfUploader>
                </Template>
            </RichTextEditorCustomToolbarItem>
            <RichTextEditorCustomToolbarItem Name="ExportHTML">
                <Template>
                    <SfButton OnClick="DownloadFile" CssClass="e-icons e-export"></SfButton>
                </Template>
            </RichTextEditorCustomToolbarItem>
            <RichTextEditorCustomToolbarItem Name="ImportRTF">
                <Template>
                    <SfUploader ID="UploadFiles" ShowFileList="false" CssClass="e-import">
                        <UploaderAsyncSettings SaveUrl="api/RTFEditor/Import/RTF"></UploaderAsyncSettings>
                        <UploaderEvents Success="OnSuccess"></UploaderEvents>
                        <UploaderButtons Browse=""></UploaderButtons>
                    </SfUploader>
                </Template>
            </RichTextEditorCustomToolbarItem>
            <RichTextEditorCustomToolbarItem Name="ExportRTF">
                <Template>
                    <SfButton OnClick="OnExport" CssClass="e-icons e-export"></SfButton>
                </Template>
            </RichTextEditorCustomToolbarItem>
        </RichTextEditorCustomToolbarItems>
    </RichTextEditorToolbarSettings>
</SfRichTextEditor>

<style>

    .e-btn.e-icons.e-export::before {
        content: '\e780';
        color: #fff;
    }

    .e-richtexteditor .e-rte-toolbar .e-toolbar-item .e-icons.e-export {
        padding: 8px;
    }

    .e-import.e-upload .e-upload-browse-btn {
        font-family: "e-icons";
    }

    .e-import.e-upload .e-file-select-wrap {
        padding: 0px;
    }

    .e-import.e-upload .e-file-drop, .e-import.e-upload .e-file-select {
        display: none;
    }

    .e-import .e-upload-browse-btn::before {
        content: '\e726';
    }
</style>

<div class="upload-amount">
</div>


@code {
    [Parameter]
    public string Content { get; set; } = string.Empty;
    [Parameter]
    public string Placeholder { get; set; } = "Please enter in a review here....";
    [Parameter]
    public int MaxLength { get; set; } = 7500;

    [Parameter]
    public int imageLimit { get; set; } = 5;
    [Parameter]
    public int videoLimit { get; set; } = 1;
    [Parameter]
    public int audioLimit { get; set; } = 2;

    [Parameter]
    public string? saveDirectory { get; set; } = "https://images.gmntgstrg.com/formats/";
    [Parameter]
    public string? ContainerName { get; set; }
    [Parameter]
    public string? ProductSlug { get; set; }
    [Parameter]
    public string? FormatHash { get; set; }

    SfRichTextEditor rteObj;
    [Inject]
    IJSRuntime? jSRuntime { get; set; }


    private int imageCount = 0;
    private int videoCount = 0;
    private int audioCount = 0;

    private string? blobDirectory { get; set; }
    private string? uploadPath { get; set; }

    public string[]? header { get; set; }
    private string? fileName { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(ProductSlug) && !string.IsNullOrWhiteSpace(FormatHash))
        {
            blobDirectory = ProductSlug + "/" + FormatHash + "/images";
        }
        else if (!string.IsNullOrWhiteSpace(ProductSlug) && string.IsNullOrWhiteSpace(FormatHash))
        {
            blobDirectory = ProductSlug + "/images";
        }
        else
        {
            blobDirectory = "images";
        }

        uploadPath = saveDirectory + blobDirectory + "/";
    }

    public void actionBegin(ActionBeginEventArgs args)
    {

        var htmlDoc = new HtmlDocument();
        htmlDoc.LoadHtml(rteObj.Value!);
        if (args.RequestType == "Image")
        {
            // Query for img elements with class 'e-rte-image'
            var imageNodes = htmlDoc.DocumentNode.SelectNodes("//img[contains(@class, 'e-rte-image')]");

            // Count the matching nodes
            imageCount = imageNodes != null ? imageNodes.Count : 0;
            if (imageCount == imageLimit)
            {
                args.Cancel = true;
            }
        }
        if (args.RequestType == "Video")
        {
            // Query for video elements with class 'e-rte-video'
            var videoNodes = htmlDoc.DocumentNode.SelectNodes("//video[contains(@class, 'e-rte-video')]");

            // Count the matching nodes
            videoCount = videoNodes != null ? videoNodes.Count : 0;
            if (videoCount == videoLimit)
            {
                args.Cancel = true;
            }
        }
        if (args.RequestType == "Audio")
        {
            // Query for audio elements with class 'e-rte-audio'
            var audioNodes = htmlDoc.DocumentNode.SelectNodes("//audio[contains(@class, 'e-rte-audio')]");

            // Count the matching nodes
            audioCount = audioNodes != null ? audioNodes.Count : 0;
            if (audioCount == audioLimit)
            {
                args.Cancel = true;
            }
        }
    }

    public void FileRemoveHandler(RemovingEventArgs args)
    {
        args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = ContainerName }, new { blobDirectory = blobDirectory } };
    }

    public void OnBeforeUploadImage(ImageUploadingEventArgs args)
    {
        args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = ContainerName }, new { blobDirectory = blobDirectory } };
    }

    public void OnMediaUploading(FileUploadingEventArgs args)
    {
        args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = ContainerName }, new { blobDirectory = blobDirectory } };
    }


    private void ImageUploadSuccess(ImageSuccessEventArgs args)
    {
        var headers = args.Response!.Headers!.ToString();
        header = headers.Split("name: ");
        header = header[1].Split("\r");

        // Update the modified image name to display a image in the editor.
        args.File!.Name = header[0];

    }

    public async Task OnImageRemovingHandler(RemovingEventArgs args)
    {
        args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = ContainerName }, new { blobDirectory = blobDirectory } };
    }

    public async Task OnImageDeleteHandler(AfterImageDeleteEventArgs args)
    {
        var imageSrc = args.Src;
        var fileName = imageSrc!.Split('/').Last();
        var content = new MultipartFormDataContent();
        var dummyFile = new ByteArrayContent(new byte[0]);
        content.Add(dummyFile, "UploadFiles", fileName);
        var request = new HttpRequestMessage(HttpMethod.Post, "api/Image/DeleteFile")
        {
            Content = content
        };
        request.Headers.Add("containerName", ContainerName);
        request.Headers.Add("blobDirectory", blobDirectory);

        // try
