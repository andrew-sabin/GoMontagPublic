        //     }
        // }
        // catch (Exception ex)
        // {
        //     Console.WriteLine($"Error deleting image: {ex.Message}");
        // }
    }

    private void onSelectionChange(Syncfusion.Blazor.RichTextEditor.SelectionChangedEventArgs args)
    {
        var contentSelected = args.SelectedContent;
    }

    private async Task onImageDelete(object args)
    {
        await HttpClient.PostAsJsonAsync("api/Image/Remove", fileName);
    }

    public void OnVideoSelctedHandler(SelectedEventArgs args)
    {
        foreach (var file in args.FilesData)
        {
            var filename = args.FilesData[0].Name;
            var path = @"path" + args.FilesData[0].Name;
            FileStream fileStream = new FileStream(path, FileMode.Create, FileAccess.Write);

            var storageString = _configuration.GetValue<string>("ConnectionStrings:storageConnection");

            var container = new BlobContainerClient(storageString, ContainerName);
            var createResponse = container.CreateIfNotExistsAsync();

            if (createResponse != null)
                container.SetAccessPolicyAsync(PublicAccessType.Blob);

            string blobPath = string.IsNullOrEmpty(blobDirectory) ?
                        filename : $"{blobDirectory}/{filename}";

            var blob = container.GetBlobClient(blobPath);

            blob.DeleteIfExistsAsync(DeleteSnapshotsOption.IncludeSnapshots);
            blob.UploadAsync(fileStream);
        }
    }

    public async Task OnSuccess(SuccessEventArgs args)
    {
        var headers = args.Response.Headers.ToString();
        var header = headers.Split("rtevalue: ");
        header = header[1].Split("\r");
        this.Content = header[0];
        await InvokeAsync(StateHasChanged);
    }

    public async Task DownloadFile()
    {
        if (!string.IsNullOrEmpty(Content) && jSRuntime != null)
        {
            WordDocument document = GetDocument(Content);
            MemoryStream stream = new MemoryStream();
            document.Save(stream, Syncfusion.DocIO.FormatType.Html);
            await SaveAs(jSRuntime, "gomontagDocument.html", stream.ToArray());
            document.Close();
            stream.Flush();
            stream.Dispose();
        }
    }

    public async Task SaveAs(IJSRuntime js, string filename, byte[] data)
    {
        await js.InvokeVoidAsync(
            "saveAsFile",
            filename,
            Convert.ToBase64String(data)
        );
    }

    public WordDocument GetDocument(string htmlText)
    {
        WordDocument document = new WordDocument();
        IWSection section = document.AddSection();
        IWParagraph paragraph = section.AddParagraph();
        paragraph.AppendHTML(htmlText);
        return document;
    }

    public WordDocument GetRTFDocument(string RTFText)
    {
        WordDocument? document = null;
        if (!string.IsNullOrEmpty(RTFText))
        {
            MemoryStream stream = new MemoryStream();
            StreamWriter writer = new StreamWriter(stream, System.Text.Encoding.Default);
            writer.Write(RTFText);
            writer.Flush();
            stream.Position = 0;
            document = new WordDocument(stream, Syncfusion.DocIO.FormatType.Html, XHTMLValidationType.None);
        }
        return document;
    }

    public async Task OnExport()
    {
        WordDocument document = GetDocument(Content);
        MemoryStream stream = new MemoryStream();
        document.Save(stream, Syncfusion.DocIO.FormatType.Rtf);
        stream.Position = 0;
        await SaveAs(jSRuntime, "sample.rtf", stream.ToArray());
        document.Close();
        stream.Flush();
        stream.Dispose();
    }

