@using HtmlAgilityPack
@rendermode InteractiveServer

@if (isLoading == false && Slug != null && !string.IsNullOrEmpty(formatHash))
{
    <div class="card mb-3">
        <div class="card-header">
            <h4>Table Of Contents</h4>
            <button class="btn btn-secondary" @onclick="ShowHideTOC">
                @if (isVisable)
                {
                    <span><i class="bi bi-list-columns-reverse"></i> Hide</span>
                }
                else
                {
                    <span><i class="bi bi-list-columns-reverse"></i> Show</span>
                }
            </button>
        </div>
        <div class="card-body" style="@(isVisable ? "display: block;" : "display: none;")">
                @foreach (var item in TocItems)
                {
                    <div class="toc-item" style="margin-left: @((item.Level - 1) * 20)px; ">
                        @if (item.Level == 1)
                        {
                            <strong><a href="/products/view/@Slug/formats/@formatHash#@item.Id">@item.Text</a></strong>
                        }
                        else
                        {
                            <a href="/products/view/@Slug/formats/@formatHash#@item.Id">@item.Text</a>
                        }

                    </div>
                }
        </div>
    </div>
}
else if (isLoading == false && string.IsNullOrEmpty(formatHash) && !isAbout && !isRules)
{
    <div class="card mb-3">
        <div class="card-header">
            <h4>Table Of Contents</h4>
            <button class="btn btn-secondary" @onclick="ShowHideTOC">
                @if (isVisable)
                {
                    <span><i class="bi bi-list-columns-reverse"></i> Hide</span>
                }
                else
                {
                    <span><i class="bi bi-list-columns-reverse"></i> Show</span>
                }
            </button>
        </div>
        <div class="card-body" style="@(isVisable ? "display: block;" : "display: none;")">
            @foreach (var item in TocItems)
            {
                <div class="toc-item" style="margin-left: @((item.Level - 1) * 20)px; ">
                    @if (item.Level == 1)
                    {
                        <strong><a href="/site-news/article/@Slug#@item.Id">@item.Text</a></strong>
                    }
                    else
                    {
                        <a href="/site-news/article/@Slug#@item.Id">@item.Text</a>
                    }

                </div>
            }
        </div>
    </div>
}
else if (isLoading == false && string.IsNullOrEmpty(formatHash) && isAbout && !isRules)
{
    <div class="card mb-3">
        <div class="card-header">
            <h4>Table Of Contents</h4>
        </div>
        <div class="card-body">
            @foreach (var item in TocItems)
            {
                <div class="toc-item" style="margin-left: @((item.Level - 1) * 20)px; ">
                    @if (item.Level == 1)
                    {
                        <strong><a href="/about#@item.Id">@item.Text</a></strong>
                    }
                    else
                    {
                        <a href="/about#@item.Id">@item.Text</a>
                    }

                </div>
            }
        </div>
    </div>
}
else if (isLoading == false && string.IsNullOrEmpty(formatHash) && !isAbout && isRules)
{
    <div class="card mb-3">
        <div class="card-header">
            <h4>Table Of Contents</h4>
        </div>
        <div class="card-body">
            @foreach (var item in TocItems)
            {
                <div class="toc-item" style="margin-left: @((item.Level - 1) * 20)px; ">
                    @if (item.Level == 1)
                    {
                        <strong><a href="/rules#@item.Id">@item.Text</a></strong>
                    }
                    else
                    {
                        <a href="/rules#@item.Id">@item.Text</a>
                    }

                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card mb-3" aria-hidden="true">
        <div class="card-header">
            <h4>Table Of Contents</h4>
        </div>
        <div class="card-body">
            <span class="placeholder col-7"></span>
            <span class="placeholder col-7"></span>
            <span class="placeholder col-7"></span>
            <span class="placeholder col-7"></span>
        </div>
    </div>
}



@code {
    [Parameter]
    public string HTMLContent { get; set; } = string.Empty;
    [Parameter]
    public string Slug { get; set; } = string.Empty;
    [Parameter]
    public string formatHash { get; set; } = string.Empty;
    [Parameter]
    public bool isRules { get; set; } = false;
    [Parameter]
    public bool isAbout { get; set; } = false;

    private bool isVisable { get; set; } = true;

    private Dictionary<int, int> headerCounts = new Dictionary<int, int>
    {
        {1,0},
        {2,0},
        {3,0},
        {4,0}
    };

    private int[] headerArray = new int[4];


    private class TocItem
    {
        public int Level { get; set; }
        public string Text { get; set; } = "";
        public string Id { get; set; } = "";
    }

    private List<TocItem> TocItems { get; set; } = new();

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await GenerateTOC();
        isLoading = false;
    }

    private async Task GenerateTOC()
    {
        TocItems.Clear();

        Array.Clear(headerArray, 0, headerArray.Length);

        var doc = new HtmlDocument();
        doc.LoadHtml(HTMLContent);

        var headers = doc.DocumentNode.SelectNodes("//h1 | //h2 | //h3 | //h4");

        if(headers != null)
        {
            foreach(var header in headers)
            {
                var id = header.GetAttributeValue("id", "");
                var text = header.InnerText;
                var level = int.Parse(header.Name.Substring(1));
                var text_level = "";

                if(level == 1)
                {
                    headerCounts[1] += 1;
                    text_level = $"{headerCounts[1]} : ";
                }
                else if(level == 2)
                {
                    headerCounts[2] += 1;
                    text_level = $"{headerCounts[1]}.{headerCounts[2]} : ";
                }
                else if(level == 3)
                {
                    headerCounts[3] += 1;
                    text_level = $"{headerCounts[1]}.{headerCounts[2]}.{headerCounts[3]} : ";
                }
                else
                {
                    headerCounts[4] += 1;
                    text_level = $"{headerCounts[1]}.{headerCounts[2]}.{headerCounts[3]}.{headerCounts[4]} : ";
                }
                TocItems.Add(new TocItem
                {
                    Id = id,
                    Text = string.Concat(text_level, text),
                    Level = level
                });
                for(int itr = level + 1; itr <= 4; itr++)
                {
                    headerCounts[itr] = 0;
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ShowHideTOC()
    {
        if (isVisable)
        {
            isVisable = false;
        }
        else
        {
            isVisable = true;
        }
    }
}
