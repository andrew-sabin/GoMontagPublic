@using GoMontag_WebApp.Components.Shared
@inject IJSRuntime JS
@inject IUserTimeZoneService TimeZoneService
@inject NavigationManager navigationManager
@inherits LayoutComponentBase

<div class="page">
    <HeadContent>
        <RadzenTheme Theme="material" />
    </HeadContent>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="sidebar">
                <AdminNavMenu />
            </div>
        </Authorized>
    </AuthorizeView>
        
    <main>
        <div class="top-row">
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <div class="container-fluid">
                    <a class="navbar-brand" href="">
                        <img src="https://images.gmntgstrg.com/defaultandresourceimages/gomontag-02_fit.svg" alt="Logo" width="174" height="42" class="d-inline-block">
                    </a>
                </div>
            </nav>
            <LoginDisplay />
        </div>
        <div class="site-navs">
            <nav class="nav justify-content-center">
                <a class="nav-link" href="">Home</a>
                <a class="nav-link" href="/about">About This Site</a>
                <a class="nav-link" href="/contact">Contact Me</a>
                <a class="nav-link" href="/site-news">Blog</a>
                <a class="nav-link" href="/control-your-internet">Take Back Your Internet</a>
            </nav>
        </div>

        <article class="content px-4">
            <ErrorBoundary Context="exception" @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <PageTitle>An Error Occurred - GoMontag</PageTitle>
                    <h2 class="text-danger"><i class="bi bi-shield-fill-exclamation"></i> An Error Has Occurred</h2>
                    <div class="p-3 mb-2 rounded-4 bg-danger bg-opacity-50">
                        <p><strong>@exception.Message</strong></p>
                    </div>
                    <p>If you have seen this error repeatedly while trying to access a page that does exist, please <strong><a target="_blank" href="/contact">contact me</a> with the following information:</strong>.</p>
                    <ul>
                        <li>The page URL that this error occurs on.</li>
                        <li>The details of the kind of error that the error occurs on.</li>
                        <li>The device, PC Operating System or Phone Model, you are using.</li>
                        <li>The internet browser you are using to browse GoMontag.</li>
                        <li>Any other details you can provide that would help me with debugging this problem.</li>
                    </ul>
                </ErrorContent>
            </ErrorBoundary>
        </article>
        <br />
        <footer class="footer px-4 py-4">
            <h4>Support The Site</h4>
            <a class="btn kofi-btn" href="https://ko-fi.com/gomontag" target="blank">
                <svg xmlns="http://www.w3.org/2000/svg" height="14" width="14" viewBox="0 0 512 512"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path fill="rgb(255, 255, 255)" d="M249.8 75c89.8 0 113 1.1 146.3 4.4 78.1 7.8 123.6 56 123.6 125.2l0 8.9c0 64.3-47.1 116.9-110.8 122.4-5 16.6-12.8 33.2-23.3 49.9-24.4 37.7-73.1 85.3-162.9 85.3l-17.7 0c-73.1 0-129.7-31.6-163.5-89.2-29.9-50.4-33.8-106.4-33.8-181.2 0-73.7 44.4-113.6 96.4-120.2 39.3-5 88.1-5.5 145.7-5.5zm0 41.6c-60.4 0-103.6 .5-136.3 5.5-46 6.7-64.3 32.7-64.3 79.2l.2 25.7c1.2 57.3 7.1 97.1 27.5 134.5 26.6 49.3 74.8 68.2 129.7 68.2l17.2 0c72 0 107-34.9 126.3-65.4 9.4-15.5 17.7-32.7 22.2-54.3l3.3-13.8 19.9 0c44.3 0 82.6-36 82.6-82l0-8.3c0-51.5-32.2-78.7-88.1-85.3-31.6-2.8-50.4-3.9-140.2-3.9zM267 169.2c38.2 0 64.8 31.6 64.8 67 0 32.7-18.3 61-42.1 83.1-15 15-39.3 30.5-55.9 40.5-4.4 2.8-10 4.4-16.7 4.4-5.5 0-10.5-1.7-15.5-4.4-16.6-10-41-25.5-56.5-40.5-21.8-20.8-39.2-46.9-41.3-77l-.2-6.1c0-35.5 25.5-67 64.3-67 22.7 0 38.8 11.6 49.3 27.7 11.6-16.1 27.2-27.7 49.9-27.7zm122.5-3.9c28.3 0 43.8 16.6 43.8 43.2s-15.5 42.7-43.8 42.7c-8.9 0-13.8-5-13.8-11.7l0-62.6c0-6.7 5-11.6 13.8-11.6z" /></svg>
                <strong>Support Me On Ko-fi</strong></a>
            <a class="btn patreon-btn" href="https://www.patreon.com/cw/GoMontag" target="blank">
                <svg xmlns="http://www.w3.org/2000/svg" height="14" width="14" viewBox="0 0 512 512"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path fill="rgb(255, 255, 255)" d="M490 153.8c-.1-65.4-51-119-110.7-138.3-74.2-24-172-20.5-242.9 12.9-85.8 40.5-112.8 129.3-113.8 217.8-.8 72.8 6.4 264.4 114.6 265.8 80.3 1 92.3-102.5 129.5-152.3 26.4-35.5 60.5-45.5 102.4-55.9 72-17.8 121.1-74.7 121-150l-.1 0z" /></svg> 
                <strong>Support Me On Patreon</strong></a>
            <h4>Follow Us</h4>
            <a class="btn btn-outline-primary" href="https://gomontag.bsky.social" title="Bluesky" target="blank"><i class="bi bi-bluesky"></i></a>
            <a class="btn btn-outline-primary" href="https://x.com/GoMontag" title="Twitter" target="blank"><i class="bi bi-twitter-x"></i></a>
            <a class="btn btn-outline-primary" href="https://www.instagram.com/gomontagofficial/" title="Instagram" target="blank"><i class="bi bi-instagram"></i></a>
            <a class="btn btn-outline-danger" href="@YoutubeChannel" title="YouTube" target="blank"><i class="bi bi-youtube"></i></a>
            <p>
                About: <a href="/about">Learn More About GoMontag</a><br />
                Contact: <a href="/contact">Email Me Here</a><br />
                Powered by Andy<br />
                © 2026 Andy. All rights reserved.<br />
                <strong>Credits: </strong> <a href="/credits">See all credits and attributes here.</a>
            </p>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string YoutubeChannel = "https://www.youtube.com/@GoMontagOfficial";

    private ErrorBoundary? _errorBoundary;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tz = await JS.InvokeAsync<string>("getTimeZone");
            TimeZoneService.TimeZoneId = tz ?? "UTC";
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _errorBoundary?.Recover();
    }
}